    #[tokio::test]
    async fn test_query_builder() {
        use crate::query_builder::QueryBuilder;
        use crate::entities::user;

        // 测试查询构建器
        let query = QueryBuilder::<user::Entity>::new()
            .eq_opt(user::Column::Email, Some("test@example.com"))
            .like_opt(user::Column::Nickname, Some("test"))
            .order_desc(user::Column::CreatedAt)
            .limit(10)
            .build();

        // 验证查询构建成功
        assert!(true);
    }
